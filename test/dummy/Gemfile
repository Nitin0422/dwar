# frozen_string_literal: true

# Test harness for the dwar engine (test/dummy). Delegates to the engine's
# root Gemfile so `bundle exec` resolves the same gems (rails, dwar, sqlite3,
# puma) whether run from the gem root or from test/dummy. Always run
# `bundle install` from the gem root, never from here (see CONTRIBUTING.md).
eval_gemfile File.expand_path("../../Gemfile", __dir__)
