<h1>Groups</h1>

<p><%= link_to "New group", new_admin_group_path, class: "dwar-btn dwar-btn--primary" %></p>

<p>Showing up to <%= Dwar::Admin::GroupsController::GROUP_LIMIT %> groups, ordered by name. Pagination is not yet implemented.</p>

<% if @groups.any? %>
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Description</th>
        <th>Members</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @groups.each do |group| %>
        <tr>
          <td><%= group.name %></td>
          <td><%= group.description %></td>
          <td><%= @member_counts[group.id] || 0 %></td>
          <td>
            <div class="dwar-actions">
              <%= link_to "Manage members", admin_group_memberships_path(group), class: "dwar-btn" %>
              <%= link_to "Edit", edit_admin_group_path(group), class: "dwar-btn" %>
              <%= button_to "Destroy", admin_group_path(group),
                  method: :delete,
                  class: "dwar-btn dwar-btn--danger",
                  form: {class: "button_to dwar-action-form", data: {turbo_confirm: "Are you sure?"}} %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No groups found.</p>
<% end %>
