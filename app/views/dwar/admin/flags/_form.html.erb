<%= form_with model: [:admin, @flag], local: true do |form| %>
  <% if @flag.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(@flag.errors.count, "error") %> prohibited this flag from being saved:</h2>
      <ul>
        <% @flag.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :key %>
    <%= form.text_field :key %>
  </div>

  <div>
    <%= form.label :description %>
    <%= form.text_area :description %>
  </div>

  <div>
    <%= form.label :state %>
    <%= form.select :state, Dwar::Flag.states.keys %>
  </div>

  <div>
    <%= form.label :percentage %>
    <%= form.number_field :percentage, in: 0..100 %>
  </div>

  <fieldset class="dwar-group-picker">
    <legend>Groups</legend>
    <div class="dwar-checkbox-list">
      <%= form.collection_check_boxes :group_ids, group_options, :id, :name do |builder| %>
        <%= builder.label(class: "dwar-checkbox") do %>
          <%= builder.check_box %>
          <%= builder.text %>
        <% end %>
      <% end %>
    </div>
    <% if group_options_capped? %>
      <p>Showing up to <%= Dwar::Admin::FlagsController::GROUP_OPTIONS_LIMIT %> groups; groups already targeted by this flag are always included.</p>
    <% end %>
  </fieldset>

  <div>
    <%= form.submit %>
  </div>
<% end %>
