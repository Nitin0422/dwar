<h1>Flags</h1>

<p><%= link_to "New flag", new_admin_flag_path, class: "dwar-btn dwar-btn--primary" %></p>

<%= form_with url: admin_flags_path, method: :get, local: true, class: "dwar-search" do |form| %>
  <div>
    <%= form.label :q, "Search" %>
    <%= form.search_field :q, value: params[:q] %>
    <%= form.submit "Search" %>
  </div>
<% end %>

<p>Showing up to <%= Dwar::Admin::FlagsController::FLAG_LIMIT %> flags, ordered by key. Use search to narrow the list.</p>

<table>
  <thead>
    <tr>
      <th>Key</th>
      <th>State</th>
      <th>Targeting</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% if @flags.any? %>
      <% @flags.each do |flag| %>
        <tr>
          <td><%= flag.key %></td>
          <td><%= flag.state %></td>
          <td>
            <% if flag.groups_and_percentage? %>
              <%= flag.percentage %>% &middot; <%= flag.groups.map(&:name).join(", ").presence || "(no groups)" %>
            <% elsif flag.percentage? %>
              <%= flag.percentage %>%
            <% elsif flag.groups? %>
              <%= flag.groups.map(&:name).join(", ").presence || "(no groups)" %>
            <% elsif flag.enabled? %>
              Everyone
            <% else %>
              &mdash;
            <% end %>
          </td>
          <td>
            <div class="dwar-actions">
              <%= link_to "Edit", edit_admin_flag_path(flag), class: "dwar-btn" %>
              <%= button_to "Destroy", admin_flag_path(flag),
                  method: :delete,
                  class: "dwar-btn dwar-btn--danger",
                  form: {class: "button_to dwar-action-form", data: {turbo_confirm: "Are you sure?"}} %>
            </div>
          </td>
        </tr>
      <% end %>
    <% else %>
      <tr>
        <td colspan="4">No flags found.</td>
      </tr>
    <% end %>
  </tbody>
</table>
