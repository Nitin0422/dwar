<!DOCTYPE html>
<html>
  <head>
    <title>Dwar Admin</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <style>
      body { font-family: system-ui, -apple-system, sans-serif; margin: 0; padding: 0; }
      header { background: #1a1a2e; color: #fff; padding: 1rem 2rem; }
      header h1 { margin: 0; font-size: 1.25rem; }
      nav a { color: #c4c4e8; text-decoration: none; margin-right: 1rem; }
      nav a:hover { color: #fff; }
      main { padding: 2rem; }
      /* Dwar design tokens: --dwar-accent (#4f46e5), --dwar-accent-hover
         (#4338ca), --dwar-danger (#b91c1c), --dwar-danger-hover (#991b1b),
         --dwar-text (#111827), --dwar-border (#6b7280), --dwar-surface
         (#ffffff), --dwar-surface-muted (#f9fafb), --dwar-radius (6px),
         --dwar-control-height (32px). */
      main {
        --dwar-accent: #4f46e5;
        --dwar-accent-hover: #4338ca;
        --dwar-danger: #b91c1c;
        --dwar-danger-hover: #991b1b;
        --dwar-text: #111827;
        /* UI boundaries: #6b7280 is 4.83:1 vs #fff and 4.63:1 vs #f9fafb,
           meeting WCAG 2.1 AA 1.4.11 non-text contrast (>= 3:1). */
        --dwar-border: #6b7280;
        --dwar-surface: #ffffff;
        --dwar-surface-muted: #f9fafb;
        --dwar-radius: 6px;
        --dwar-control-height: 32px;
      }
      /* Forms: stacked controls, labels above fields, ~680px content width.
         Keep the error container out of the field-wrapper grid via its own
         ID rule; an ID inside :not() here would outrank the search rule. */
      main form:not(.button_to) { display: grid; gap: 1rem; max-width: 680px; }
      main form:not(.button_to) > div { display: grid; gap: 0.35rem; }
      main #error_explanation { display: block; }
      main form.dwar-search { display: flex; max-width: none; }
      main form.dwar-search > div { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 0.5rem; }
      main form.button_to { display: inline; margin: 0; }
      main label { color: var(--dwar-text); font-weight: 500; }
      /* Shared control styling; global element selectors also cover host
         markup such as the memberships add-member form. */
      main input[type="text"],
      main input[type="search"],
      main input[type="number"],
      main select,
      main textarea {
        box-sizing: border-box;
        width: 100%;
        min-height: var(--dwar-control-height);
        padding: 0.35rem 0.5rem;
        border: 1px solid var(--dwar-border);
        border-radius: var(--dwar-radius);
        background: var(--dwar-surface);
        color: var(--dwar-text);
        font: inherit;
      }
      main textarea { min-height: 5rem; }
      main form.dwar-search input[type="search"] { width: auto; }
      /* Shared button family (links, input submits, button submits). */
      main .dwar-btn,
      main input[type="submit"],
      main button[type="submit"] {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        justify-self: start;
        box-sizing: border-box;
        min-height: var(--dwar-control-height);
        padding: 0 0.85rem;
        border: 1px solid var(--dwar-border);
        border-radius: var(--dwar-radius);
        background: var(--dwar-surface);
        color: var(--dwar-text);
        font: inherit;
        font-weight: 500;
        line-height: 1;
        text-decoration: none;
        cursor: pointer;
      }
      main .dwar-btn:hover { background: var(--dwar-surface-muted); }
      main .dwar-btn.dwar-btn--primary,
      main form:not(.button_to) input[type="submit"],
      main form:not(.button_to) button[type="submit"] {
        border-color: var(--dwar-accent);
        background: var(--dwar-accent);
        color: #fff;
      }
      main .dwar-btn.dwar-btn--primary:hover,
      main form:not(.button_to) input[type="submit"]:hover,
      main form:not(.button_to) button[type="submit"]:hover {
        border-color: var(--dwar-accent-hover);
        background: var(--dwar-accent-hover);
      }
      main .dwar-btn.dwar-btn--danger {
        border-color: var(--dwar-danger);
        background: var(--dwar-danger);
        color: #fff;
      }
      main .dwar-btn.dwar-btn--danger:hover {
        border-color: var(--dwar-danger-hover);
        background: var(--dwar-danger-hover);
      }
      /* Index-table action cluster. The table tag stays bare; only the
         minimum descendant rule needed to align row actions. */
      main td { vertical-align: middle; }
      main .dwar-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
      main .dwar-actions--end { justify-content: flex-end; }

      /* Admin page shell: title/subtitle on the left, primary action right. */
      main .dwar-page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
        margin-bottom: 1.5rem;
      }
      main .dwar-page-header h1 { margin: 0; }
      main .dwar-page-subtitle { margin: 6px 0 0; color: #6b7280; font-size: 14px; }

      /* Card: groups a section header, body, and footer behind one border. */
      main .dwar-card {
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        overflow: hidden;
        background: var(--dwar-surface);
      }
      main .dwar-card + .dwar-card { margin-top: 1.5rem; }
      main .dwar-card__header { padding: 20px; border-bottom: 1px solid #e5e7eb; }
      main .dwar-card__header h2 { margin: 0; font-size: 18px; font-weight: 600; color: var(--dwar-text); }
      main .dwar-card__intro { margin-bottom: 16px; }
      main .dwar-card__body { padding: 20px; }
      main .dwar-card__footer {
        padding: 16px 20px;
        border-top: 1px solid #e5e7eb;
        background: var(--dwar-surface-muted);
      }

      /* Tables sit inside a card. The <table>/<td> tags stay bare so row
         markup remains semantic; styling comes from the card ancestor. */
      main .dwar-card table { width: 100%; border-collapse: collapse; text-align: left; }
      main .dwar-card thead tr { background: var(--dwar-surface-muted); }
      main .dwar-card th {
        padding: 12px 20px;
        font-size: 12px;
        font-weight: 600;
        color: #6b7280;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }
      main .dwar-card td { padding: 16px 20px; }
      main .dwar-card tbody tr + tr { border-top: 1px solid #e5e7eb; }
      main .dwar-card .dwar-col-actions { text-align: right; }
      main .dwar-table-wrap { overflow-x: auto; }
      main .dwar-card td.dwar-empty-cell { padding: 0; }
      main .dwar-row-key { font-weight: 500; color: var(--dwar-text); }
      main .dwar-cell-muted { color: #6b7280; }

      /* Empty state shown in place of table rows. */
      main .dwar-empty { padding: 48px 20px; text-align: center; }
      main .dwar-empty__title { margin: 0 0 8px; font-size: 16px; font-weight: 600; color: var(--dwar-text); }
      main .dwar-empty__text { margin: 0; color: #6b7280; font-size: 14px; }

      /* Status pill. */
      main .dwar-badge {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
        background: #f3f4f6;
        color: #4b5563;
      }
      main .dwar-badge--on { background: #dcfce7; color: #166534; }

      /* Form layout: fields stack inside the card body. */
      main .dwar-field { margin-bottom: 20px; }
      main .dwar-field > label { display: block; margin-bottom: 8px; font-size: 13px; font-weight: 600; color: #374151; }
      main .dwar-hint { margin: 6px 0 0; font-size: 12px; color: #6b7280; }
      main .dwar-form-page { max-width: 680px; }
      main form.dwar-form { display: block; max-width: none; }
      main form.dwar-form > div { display: block; gap: 0; }

      /* Inline validation alert. */
      main .dwar-alert {
        margin: 20px;
        padding: 16px;
        border: 1px solid #fecaca;
        border-radius: 8px;
        background: #fef2f2;
        color: #b91c1c;
      }
      main .dwar-alert--inline { margin: 0 0 20px; }
      main .dwar-alert h3 { margin: 0 0 10px; font-size: 14px; font-weight: 600; }
      main .dwar-alert ul { margin: 0; padding-left: 20px; font-size: 14px; }
      main .dwar-alert li { margin-bottom: 4px; }

      /* Search bar: input grows, submit sits beside it. */
      main form.dwar-search { align-items: center; }
      main form.dwar-search > div { align-items: center; }
      main form.dwar-search input[type="search"] { flex: 1 1 auto; min-width: 0; }

      /* Flag group picker: scrollable checkbox panel inside a fieldset. */
      main .dwar-group-picker {
        margin: 0;
        padding: 16px;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
      }
      main .dwar-group-picker legend { padding: 0 6px; font-weight: 600; color: var(--dwar-text); }
      main .dwar-checkbox-list { display: grid; gap: 0.5rem; max-height: 16rem; overflow-y: auto; margin-top: 8px; }
      main .dwar-checkbox {
        display: flex;
        align-items: center;
        gap: 0.625rem;
        padding: 0.625rem 0.75rem;
        border: 1px solid #e5e7eb;
        border-radius: 6px;
        background: var(--dwar-surface-muted);
        font-weight: 400;
        cursor: pointer;
      }
      main .dwar-checkbox:hover { background: #f3f4f6; }
      main .dwar-checkbox input[type="checkbox"] { width: 1rem; height: 1rem; margin: 0; accent-color: var(--dwar-accent); }
      /* Visible keyboard focus ring. */
      main a:focus-visible,
      main button:focus-visible,
      main input:focus-visible,
      main select:focus-visible,
      main textarea:focus-visible { outline: 2px solid var(--dwar-accent); outline-offset: 2px; }
      @media (max-width: 640px) {
        main { padding: 1rem; }
        main form.dwar-search input[type="search"] { flex: 1 1 100%; width: 100%; }
      }
    </style>
  </head>
  <body>
    <header>
      <h1>Dwar</h1>
      <nav>
        <a href="<%= admin_flags_path %>">Flags</a>
        <a href="<%= admin_groups_path %>">Groups</a>
        <a href="<%= admin_audits_path %>">Audits</a>
      </nav>
    </header>
    <main>
      <% if flash[:notice] %>
        <p class="flash notice"><%= flash[:notice] %></p>
      <% end %>
      <% if flash[:alert] %>
        <p class="flash alert"><%= flash[:alert] %></p>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
